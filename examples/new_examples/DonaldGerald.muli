package new_examples;

import de.wwu.muli.*;
import de.wwu.muli.solution.*;

public class DonaldGerald {
    
    public static void main(String[] args) {
        Solution<Object> solution = Muli.getOneSolution(DonaldGerald::solve);
        
        int[] digits = (int[])solution.value;
        System.out.println("DONALD + GERALD = ROBERT");
        System.out.println("D=" + digits[0] + " O=" + digits[1] + " N=" + digits[2] + 
                         " A=" + digits[3] + " L=" + digits[4] + " G=" + digits[5] + 
                         " E=" + digits[6] + " R=" + digits[7] + " B=" + digits[8] + " T=" + digits[9]);
        
        int donald = digits[0] * 100000 + digits[1] * 10000 + digits[2] * 1000 + 
                     digits[3] * 100 + digits[4] * 10 + digits[0];
        int gerald = digits[5] * 100000 + digits[6] * 10000 + digits[7] * 1000 + 
                     digits[3] * 100 + digits[4] * 10 + digits[0];
        int robert = digits[7] * 100000 + digits[1] * 10000 + digits[8] * 1000 + 
                     digits[6] * 100 + digits[7] * 10 + digits[9];
        
        System.out.println(donald + " + " + gerald + " = " + robert);
    }
    
    private static int[] solve() {
        int[] digits = new int[10];
        
        for (int i = 0; i < 10; i++) {
            int val free;
            if (val < 0 || val > 9) {
                throw Muli.fail();
            }
            digits[i] = val;
        }
        
        for (int i = 0; i < 10; i++) {
            for (int j = i + 1; j < 10; j++) {
                if (digits[i] == digits[j]) {
                    throw Muli.fail();
                }
            }
        }
        
        int d = digits[0];
        int o = digits[1];
        int n = digits[2];
        int a = digits[3];
        int l = digits[4];
        int g = digits[5];
        int e = digits[6];
        int r = digits[7];
        int b = digits[8];
        int t = digits[9];
        
        if (d == 0) throw Muli.fail();
        if (g == 0) throw Muli.fail();
        if (r == 0) throw Muli.fail();
        
        int donald = d * 100000 + o * 10000 + n * 1000 + a * 100 + l * 10 + d;
        int gerald = g * 100000 + e * 10000 + r * 1000 + a * 100 + l * 10 + d;
        int robert = r * 100000 + o * 10000 + b * 1000 + e * 100 + r * 10 + t;
        
        if (donald + gerald != robert) {
            throw Muli.fail();
        }
        
        return digits;
    }
}
