package new_examples;

import de.wwu.muli.*;
import de.wwu.muli.solution.*;

public class MagicSquare {
    
    public static void main(String[] args) {
        Solution<Object> solution = Muli.getOneSolution(MagicSquare::solve);
        
        int[][] square = (int[][])solution.value;
        System.out.println("Magic Square Solution:");
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                System.out.print(square[i][j] + " ");
            }
            System.out.println();
        }
    }
    
    private static int[][] solve() {
        int[][] square = new int[3][3];
        int target = 15;
        
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                int val free;
                if (val < 1 || val > 9) {
                    throw Muli.fail();
                }
                square[i][j] = val;
            }
        }
        
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                for (int k = 0; k < 3; k++) {
                    for (int l = 0; l < 3; l++) {
                        if (i == k && j == l) continue;
                        if (square[i][j] == square[k][l]) {
                            throw Muli.fail();
                        }
                    }
                }
            }
        }
        
        for (int i = 0; i < 3; i++) {
            int rowSum = square[i][0] + square[i][1] + square[i][2];
            if (rowSum != target) {
                throw Muli.fail();
            }
        }
        
        for (int j = 0; j < 3; j++) {
            int colSum = square[0][j] + square[1][j] + square[2][j];
            if (colSum != target) {
                throw Muli.fail();
            }
        }
        
        int diag1 = square[0][0] + square[1][1] + square[2][2];
        if (diag1 != target) {
            throw Muli.fail();
        }
        
        int diag2 = square[0][2] + square[1][1] + square[2][0];
        if (diag2 != target) {
            throw Muli.fail();
        }
        
        return square;
    }
}
