package brrond;

import de.wwu.muli.*;
import de.wwu.muli.solution.*;

public class Some {
    int sum;
}

public class Simple {

    public static void main(String[] args) {
          Solution<Object> solution = Muli.getOneSolution(Simple::solve);

          // System.out.println("Found " + solutions.length + " solutions");
          // for (Solution<Object> solution : solutions) {
              float[] some = (float[])solution.value;
              System.out.println("Len: " + some.length);
              for (int i = 0; i < some.length; i++) {
                System.out.println(some[i] + " ");
              }
              // System.out.println(some);
          // }
      }

    private static float[] solve() {
        float[] solution free;

        float a = 1, b = -6, c = -16;

        if (solution[0] * solution[0] * a + solution[0] * b + c != 0f) {
            throw Muli.fail();
        }
        if (solution[1] * solution[1] * a + solution[1] * b + c != 0f) {
            throw Muli.fail();
        }

        if (solution[0] == solution[1]) {
            throw Muli.fail();
        }

        return solution;
    }
}