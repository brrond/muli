package brrond.sudoku;

import java.io.PrintStream;

import de.wwu.muli.*;
import de.wwu.muli.solution.*;

public class Sudoku {
    public static int SIZE = 3;

    public static class Board {
        int[] arr;

        public String toString() {
            StringBuilder stringBuilder = new StringBuilder();
            for (int i = 0; i < arr.length; i++) {
                stringBuilder.append(arr[i]).append(" ");
            }
            return stringBuilder.toString();
        }
    }

    public static void main(String[] args) {

        Solution<Object> solution = Muli.getOneSolution(Sudoku::solve);
        Board board = (Board) solution.value;
        System.out.println(board);
    }

    public static Board solve() {
        Board board = new Board();
        board.arr = new int[9];
        int[] arr free;

        if (arr.length != 9) {
            throw Muli.fail();
        }

        if (arr[0] != 5) {
            throw Muli.fail();
        }

        for (int i = 1; i < 9; i++) {
            if (arr[0] == arr[i]) {
                throw Muli.fail();
            }
        }

        if (arr[1] == arr[2] || arr[1] == arr[3] ||
            arr[1] == arr[4] || arr[1] == arr[5] || arr[1] == arr[6] ||
            arr[1] == arr[7] || arr[1] == arr[8]) {
            throw Muli.fail();
        }

        if (arr[2] == arr[3] ||
            arr[2] == arr[4] || arr[2] == arr[5] || arr[2] == arr[6] ||
            arr[2] == arr[7] || arr[2] == arr[8]) {
            throw Muli.fail();
        }

        if (arr[3] == arr[4] || arr[3] == arr[5] || arr[3] == arr[6] ||
            arr[3] == arr[7] || arr[3] == arr[8]) {
            throw Muli.fail();
        }

        if (arr[4] == arr[5] || arr[4] == arr[6] ||
            arr[4] == arr[7] || arr[4] == arr[8]) {
            throw Muli.fail();
        }

        if (arr[5] == arr[6] ||
            arr[5] == arr[7] || arr[5] == arr[8]) {
            throw Muli.fail();
        }

        if (arr[6] == arr[7] || arr[6] == arr[8]) {
            throw Muli.fail();
        }

        if (arr[7] == arr[8]) {
            throw Muli.fail();
        }

        board.arr[0] = arr[0];
        board.arr[1] = arr[1];
        board.arr[2] = arr[2];
        board.arr[3] = arr[3];
        board.arr[4] = arr[4];
        board.arr[5] = arr[5];
        board.arr[6] = arr[6];
        board.arr[7] = arr[7];
        board.arr[8] = arr[8];

        return board;
    }
}
