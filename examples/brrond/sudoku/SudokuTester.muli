package brrond.sudoku;

public class SudokuTester {
    public static void main(String[] args) {
        test1();
        test2();
        test3();
    }

    private static void test1() {
        System.out.println("test1");
        Board board = Sudoku.solve(new int[][] {
            {0, 0, 8, 0, 4, 5, 0, 0, 0},
            {0, 9, 5, 3, 0, 0, 0, 1, 0},
            {0, 0, 0, 0, 8, 0, 2, 3, 0},
            {4, 0, 0, 5, 0, 0, 6, 0, 0},
            {2, 0, 0, 0, 0, 0, 0, 0, 7},
            {8, 0, 3, 0, 7, 6, 0, 4, 2},
            {9, 0, 2, 6, 0, 0, 0, 0, 4},
            {0, 1, 0, 0, 3, 0, 9, 0, 0},
            {0, 0, 7, 0, 0, 0, 5, 8, 0}
        }, new int[][] {
            {3, 2, 8, 1, 4, 5, 7, 6, 9},
            {7, 9, 5, 3, 6, 2, 4, 1, 8},
            {1, 4, 6, 7, 8, 9, 2, 3, 5},
            {4, 7, 1, 5, 2, 8, 6, 9, 3},
            {2, 6, 9, 4, 1, 3, 8, 5, 7},
            {8, 5, 3, 9, 7, 6, 1, 4, 2},
            {9, 8, 2, 6, 5, 1, 3, 7, 4},
            {5, 1, 4, 8, 3, 7, 9, 2, 6},
            {6, 3, 7, 2, 9, 4, 5, 8, 1}
        });

        System.out.println(board);
        System.out.println("Solved: " + board.isSolved());
    }

    /**
     * 4 0 0 9 0 2 0 0 0
     * 0 6 0 0 1 0 8 0 4
     * 7 0 0 6 0 0 0 3 0
     * 0 5 9 8 0 0 0 0 7
     * 2 0 0 0 0 0 0 9 0
     * 0 8 0 3 0 0 0 1 0
     * 5 0 3 0 0 6 9 0 0
     * 0 0 0 0 0 4 0 0 2
     * 0 0 0 1 7 9 6 5 0
     *
     * 4 3 8 9 5 2 1 7 6
     * 9 6 5 7 1 3 8 2 4
     * 7 2 1 6 4 8 5 3 9
     * 3 5 9 8 2 1 4 6 7
     * 2 1 7 4 6 5 3 9 8
     * 6 8 4 3 9 7 2 1 5
     * 5 7 3 2 8 6 9 4 1
     * 1 9 6 5 3 4 7 8 2
     * 8 4 2 1 7 9 6 5 3
     **/
    private static void test2() {
        System.out.println("test2");
        Board board = Sudoku.solve(new int[][] {
            {4, 0, 0, 9, 0, 2, 0, 0, 0},
            {0, 6, 0, 0, 1, 0, 8, 0, 4},
            {7, 0, 0, 6, 0, 0, 0, 3, 0},
            {0, 5, 9, 8, 0, 0, 0, 0, 7},
            {2, 0, 0, 0, 0, 0, 0, 9, 0},
            {0, 8, 0, 3, 0, 0, 0, 1, 0},
            {5, 0, 3, 0, 0, 6, 9, 0, 0},
            {0, 0, 0, 0, 0, 4, 0, 0, 2},
            {0, 0, 0, 1, 7, 9, 6, 5, 0}
        }, new int[][] {
            {4, 3, 8, 9, 5, 2, 1, 7, 6},
            {9, 6, 5, 7, 1, 3, 8, 2, 4},
            {7, 2, 1, 6, 4, 8, 5, 3, 9},
            {3, 5, 9, 8, 2, 1, 4, 6, 7},
            {2, 1, 7, 4, 6, 5, 3, 9, 8},
            {6, 8, 4, 3, 9, 7, 2, 1, 5},
            {5, 7, 3, 2, 8, 6, 9, 4, 1},
            {1, 9, 6, 5, 3, 4, 7, 8, 2},
            {8, 4, 2, 1, 7, 9, 6, 5, 3},
        });

        System.out.println(board);
        System.out.println("Solved: " + board.isSolved());
    }

    /**
     * 0 0 0 0 0 3 8 0 4
     * 0 0 4 0 0 0 0 9 0
     * 0 5 0 0 0 2 1 0 0
     * 0 0 3 9 0 0 0 0 7
     * 2 0 0 4 0 7 0 0 8
     * 7 0 0 0 0 1 4 0 0
     * 0 0 8 3 0 0 0 4 0
     * 0 7 0 0 0 0 2 0 0
     * 0 7 0 0 0 0 2 0 0
     * 6 0 1 7 0 0 0 0 0
     */
    private static void test3() {
        System.out.println("test3");
            Board board = Sudoku.solve(new int[][] {
                {0, 0, 0, 0, 0, 3, 8, 0, 4},
                {0, 0, 4, 0, 0, 0, 0, 9, 0},
                {0, 5, 0, 0, 0, 2, 1, 0, 0},
                {0, 0, 3, 9, 0, 0, 0, 0, 7},
                {2, 0, 0, 4, 0, 7, 0, 0, 8},
                {7, 0, 0, 0, 0, 1, 4, 0, 0},
                {0, 0, 8, 3, 0, 0, 0, 4, 0},
                {0, 7, 0, 0, 0, 0, 2, 0, 0},
                {6, 0, 1, 7, 0, 0, 0, 0, 0}
            }, null);

            System.out.println(board);
            System.out.println("Solved: " + board.isSolved());
        }
}